{
  "title": "Common-emitter amplifier: bias point, frequency response, 1 kHz sine",

  // A model can be pasted as a SPICE ".model" line; here the general NPN
  // transistor of the editor's standard library (textbook values).
  "models": {
    "NPN_GEN": ".model NPN_GEN NPN(IS=1e-14 BF=200 BR=2 CJE=10p CJC=5p TF=0.5n)"
  },

  "components": [
    { "type": "V", "name": "VCC", "nodes": ["vcc", "0"], "dc": 12 },
    { "type": "V", "name": "Vin", "nodes": ["in", "0"], "dc": 0, "ac": 1,
      "wave": { "type": "sin", "amplitude": "10m", "freq": "1k" } },

    { "type": "C", "name": "Cin", "nodes": ["in", "b"], "value": "10u" },
    { "type": "R", "name": "R1", "nodes": ["vcc", "b"], "value": "47k" },
    { "type": "R", "name": "R2", "nodes": ["b", "0"], "value": "10k" },
    { "type": "Q", "name": "Q1", "nodes": ["c", "b", "e"], "model": "NPN_GEN" },
    { "type": "R", "name": "RC", "nodes": ["vcc", "c"], "value": "4.7k" },
    { "type": "R", "name": "RE", "nodes": ["e", "0"], "value": "1k" },
    { "type": "C", "name": "CE", "nodes": ["e", "0"], "value": "100u" },
    { "type": "C", "name": "Cout", "nodes": ["c", "out"], "value": "10u" },
    { "type": "R", "name": "RL", "nodes": ["out", "0"], "value": "10k" }
  ],

  "analyses": [
    { "type": "op", "outputs": ["v(b)", "v(c)", "v(e)", "v(c,e)", "i(VCC)"] },
    { "type": "ac", "sweep": "dec", "points": 20, "fstart": 1, "fstop": "100meg",
      "outputs": ["v(out)"] },
    // Noise at the output and referred to the input source, with the largest contributors.
    { "type": "noise", "output": "v(out)", "input": "Vin",
      "sweep": "dec", "points": 20, "fstart": 10, "fstop": "100k" },
    // Spectrum of the last period: the transistor distorts the 10 mV sine.
    { "type": "tran", "tstop": "5m", "tstep": "10u", "outputs": ["v(in)", "v(out)", "v(c)"],
      "fourier": { "freq": "1k", "harmonics": 5, "outputs": ["v(out)"] },
      "measure": { "thd": { "thd": "v(out)", "fundamental": "1k", "from": "3m" } } }
  ]
}
