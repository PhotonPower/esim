{
  "title": "Bridge rectifier with smoothing capacitor and zener regulator",

  "models": {
    "1N4007": { "type": "diode", "is": 7.03e-9, "n": 1.81, "rs": 0.034, "cj0": "10p",
                "vj": 0.73, "m": 0.41, "tt": "4.3u" },
    "Z5V1":   { "type": "diode", "is": 1e-14, "bv": 5.1, "ibv": "5m" }
  },

  "components": [
    { "type": "V", "name": "Vac", "nodes": ["ac1", "ac2"],
      "wave": { "type": "sin", "amplitude": 12, "freq": 50 } },
    // The source floats: tie it to ground with a large resistor.
    { "type": "R", "name": "Rref", "nodes": ["ac2", "0"], "value": "1meg" },

    { "type": "D", "name": "D1", "nodes": ["ac1", "plus"], "model": "1N4007" },
    { "type": "D", "name": "D2", "nodes": ["ac2", "plus"], "model": "1N4007" },
    { "type": "D", "name": "D3", "nodes": ["0", "ac1"],    "model": "1N4007" },
    { "type": "D", "name": "D4", "nodes": ["0", "ac2"],    "model": "1N4007" },

    { "type": "C", "name": "C1", "nodes": ["plus", "0"], "value": "470u" },
    { "type": "R", "name": "Rz", "nodes": ["plus", "reg"], "value": 220 },
    { "type": "D", "name": "DZ", "nodes": ["0", "reg"], "model": "Z5V1" },
    { "type": "R", "name": "RL", "nodes": ["reg", "0"], "value": "1k" }
  ],

  "analyses": [
    { "type": "tran", "tstop": "100m", "tstep": "100u" }
  ],

  "outputs": ["v(ac1,ac2)", "v(plus)", "v(reg)", "i(Vac)"]
}
