{
  // Five CMOS inverters in a ring, with transistors described by BSIM3v3, the
  // short-channel model that foundries publish parameters for. The model
  // cards are given the way they come from a foundry: as SPICE ".model" lines
  // with LEVEL=49 (a long card may be written as a list of its lines). The
  // values are typical of a 0.18 um process.
  //
  // The first analysis records the transfer curve of one inverter, the second
  // lets the ring oscillate. Changing the supply shows how strongly the speed
  // depends on it:  "param_sweep": {"param": "VDD", "values": [1.2, 1.5, 1.8]}
  "title": "Ring oscillator with BSIM3 transistors (0.18 um)",

  "parameters": { "VDD": 1.8, "wn": "1u", "wp": "2u", "len": "0.18u" },

  "models": {
    "n18": [
      ".model n18 NMOS (LEVEL=49 VERSION=3.1 TNOM=27 TOX=4.1E-9 XJ=1E-7 NCH=2.3549E17 VTH0=0.3694303",
      "+ K1=0.5789116 K2=1.110723E-3 K3=1E-3 K3B=0.0297124 W0=1E-7 NLX=2.037748E-7",
      "+ DVT0W=0 DVT1W=0 DVT2W=0 DVT0=1.2953626 DVT1=0.3421545 DVT2=0.0395588",
      "+ U0=293.1687573 UA=-1.21942E-9 UB=2.325738E-18 UC=7.061289E-11 VSAT=1.676164E5",
      "+ A0=2 AGS=0.4764546 B0=1.617101E-7 B1=5E-6 KETA=-0.0138552 A1=1.09168E-3 A2=0.3303025",
      "+ RDSW=105.6133217 PRWG=0.5 PRWB=-0.2 WR=1 WINT=2.885735E-9 LINT=1.715622E-8",
      "+ XL=0 XW=-1E-8 DWG=2.754317E-9 DWB=-3.690793E-9 VOFF=-0.0948017 NFACTOR=2.1860065",
      "+ CIT=0 CDSC=2.4E-4 CDSCD=0 CDSCB=0 ETA0=2.665034E-3 ETAB=6.028975E-5 DSUB=0.0442223",
      "+ PCLM=1.746064 PDIBLC1=0.3258185 PDIBLC2=2.701992E-3 PDIBLCB=-0.1 DROUT=0.9787232",
      "+ PSCBE1=4.494778E10 PSCBE2=3.672074E-8 PVAG=0.0122755 DELTA=0.01 MOBMOD=1",
      "+ UTE=-1.5 KT1=-0.11 KT2=0.022 UA1=4.31E-9 UB1=-7.61E-18 UC1=-5.6E-11 AT=3.3E4",
      "+ CAPMOD=2 XPART=0.5 CGDO=8.58E-10 CGSO=8.58E-10 CGBO=1E-12",
      "+ CJ=9.471097E-4 PB=0.8 MJ=0.3726161 CJSW=1.905901E-10 PBSW=0.8 MJSW=0.1369758",
      "+ PVTH0=-5.105777E-3 PRDSW=-1.1011726 PK2=2.247806E-3 WKETA=-5.071892E-3",
      "+ LKETA=5.324922E-4 PU0=-4.0206081 PUA=-4.48232E-11 PUB=5.018589E-24 PVSAT=2E3",
      "+ PETA0=1E-4 PKETA=-2.090695E-3)"
    ],
    "p18": [
      ".model p18 PMOS (LEVEL=49 VERSION=3.1 TNOM=27 TOX=4.1E-9 XJ=1E-7 NCH=4.1589E17 VTH0=-0.3823437",
      "+ K1=0.5722049 K2=0.0219717 K3=0.1576753 K3B=4.2763642 W0=1E-6 NLX=1.104212E-7",
      "+ DVT0W=0 DVT1W=0 DVT2W=0 DVT0=0.6234839 DVT1=0.2479255 DVT2=0.1",
      "+ U0=109.4682454 UA=1.31646E-9 UB=1E-21 UC=-1E-10 VSAT=1.054892E5",
      "+ A0=1.5796859 AGS=0.3115024 B0=4.729297E-7 B1=1.446715E-6 KETA=0.0298609",
      "+ A1=0.3886886 A2=0.4010376 RDSW=199.1594405 PRWG=0.5 PRWB=-0.4947034 WR=1",
      "+ WINT=0 LINT=2.93948E-8 XL=0 XW=-1E-8 DWG=-1.998034E-8 DWB=-2.481453E-9",
      "+ VOFF=-0.0935653 NFACTOR=2 CIT=0 CDSC=2.4E-4 CDSCD=0 CDSCB=0 ETA0=3.515392E-4",
      "+ ETAB=-4.804338E-4 DSUB=1.215087E-5 PCLM=0.96422 PDIBLC1=3.026627E-3",
      "+ PDIBLC2=-1E-5 PDIBLCB=-1E-3 DROUT=1.117016E-4 PSCBE1=7.999986E10",
      "+ PSCBE2=8.271897E-10 PVAG=0.0190118 DELTA=0.01 MOBMOD=1",
      "+ CAPMOD=2 XPART=0.5 CGDO=6.3E-10 CGSO=6.3E-10 CGBO=1E-12",
      "+ CJ=1.177729E-3 PB=0.8483594 MJ=0.4126727 CJSW=2.37072E-10 PBSW=0.8 MJSW=0.3316175",
      "+ PVTH0=3.360313E-3 PRDSW=10.5 PK2=2.17E-3 WKETA=0.0354115 LKETA=-2.403727E-3",
      "+ PU0=-1.5089586 PUA=-5.94214E-11 PUB=1E-21 PVSAT=50 PETA0=1E-4 PKETA=-6.740436E-3)"
    ]
  },

  "subcircuits": {
    "inv": {
      "ports": ["in", "out", "vdd"],
      "components": [
        // drain and source areas and perimeters set the junction capacitances
        { "type": "M", "name": "MP", "nodes": ["out", "in", "vdd", "vdd"], "model": "p18",
          "w": "wp", "l": "len", "ad": "wp*0.5u", "pd": "wp + 1u", "as": "wp*0.5u", "ps": "wp + 1u" },
        { "type": "M", "name": "MN", "nodes": ["out", "in", "0", "0"], "model": "n18",
          "w": "wn", "l": "len", "ad": "wn*0.5u", "pd": "wn + 1u", "as": "wn*0.5u", "ps": "wn + 1u" }
      ]
    }
  },

  "components": [
    { "type": "V", "name": "VSUP", "nodes": ["vdd", "0"], "dc": "VDD" },

    // one inverter by itself for the transfer curve, with an ammeter (0 V
    // source) in its supply
    { "type": "V", "name": "VIN", "nodes": ["in", "0"], "dc": 0 },
    { "type": "V", "name": "IDD", "nodes": ["vdd", "vdd0"], "dc": 0 },
    { "type": "X", "name": "U0", "subcircuit": "inv", "nodes": ["in", "out", "vdd0"] },

    // the ring, each stage loaded with 5 fF of wiring
    { "type": "X", "name": "U1", "subcircuit": "inv", "nodes": ["n1", "n2", "vdd"] },
    { "type": "X", "name": "U2", "subcircuit": "inv", "nodes": ["n2", "n3", "vdd"] },
    { "type": "X", "name": "U3", "subcircuit": "inv", "nodes": ["n3", "n4", "vdd"] },
    { "type": "X", "name": "U4", "subcircuit": "inv", "nodes": ["n4", "n5", "vdd"] },
    { "type": "X", "name": "U5", "subcircuit": "inv", "nodes": ["n5", "n1", "vdd"] },
    { "type": "C", "name": "C1", "nodes": ["n1", "0"], "value": "5f" },
    { "type": "C", "name": "C2", "nodes": ["n2", "0"], "value": "5f" },
    { "type": "C", "name": "C3", "nodes": ["n3", "0"], "value": "5f" },
    { "type": "C", "name": "C4", "nodes": ["n4", "0"], "value": "5f" },
    { "type": "C", "name": "C5", "nodes": ["n5", "0"], "value": "5f" }
  ],

  // the ring starts from an unbalanced state
  "ic": { "n1": "VDD" },

  "analyses": [
    { "type": "dc", "source": "VIN", "start": 0, "stop": 1.8, "step": 0.01, "outputs": ["v(out)", "i(IDD)"],
      "measure": {
        "v_switch":  { "cross": "v(out)", "level": 0.9, "edge": "fall" },
        "i_through": { "max": "i(IDD)" },
        "i_leak":    { "at": "i(IDD)", "x": 0 }
      } },
    { "type": "tran", "tstop": "4n", "uic": true, "outputs": ["v(n1)", "v(n2)", "v(n3)"],
      "measure": {
        "period":    { "period": "v(n3)", "level": 0.9, "from": "1n" },
        "frequency": { "freq": "v(n3)", "level": 0.9, "from": "1n" }
      } }
  ]
}
