{
  // Series RLC circuit that starts from a charged capacitor ("uic": the initial
  // conditions replace the DC operating point).
  // f0 = 1 / (2 pi sqrt(L C)) = 5.03 kHz, damping R / (2 L) = 1000 1/s.
  "title": "Damped RLC oscillation from initial conditions",

  "components": [
    { "type": "C", "name": "C1", "nodes": ["a", "0"], "value": "100n", "ic": 5 },
    { "type": "L", "name": "L1", "nodes": ["a", "b"], "value": "10m", "ic": 0 },
    { "type": "R", "name": "R1", "nodes": ["b", "0"], "value": 20 }
  ],

  // Weakly damped oscillation: the trapezoidal rule has no numerical damping
  // and a tighter tolerance keeps the phase error small over 25 periods.
  "options": { "reltol": 1e-5 },

  "analyses": [
    { "type": "tran", "tstop": "5m", "uic": true, "method": "trap" }
  ],

  "outputs": ["v(a)", "i(L1)"]
}
